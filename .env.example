# GrowthRig app identity (optional)
COMPANY_NAME=GrowthRig
COMPANY_ICP=B2B SaaS founders doing their own growth marketing
COMPANY_GOAL=qualified demo calls with interested prospects

# LLM drafts (optional; absent = deterministic preview fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ElevenLabs outbound voice (required for durable live calls)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Alternative accepted by the adapter:
# ELEVENLABS_CONVERSATIONAL_AI_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Supabase durable voice storage (required for durable live calls)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte base64 string. Do not commit a real value.
VOICE_PII_ENCRYPTION_KEY=

# Voice safety policy — preview-safe defaults
VOICE_OUTBOUND_ENABLED=false
VOICE_PERSISTENCE=true
VOICE_DAILY_CALL_LIMIT=5
VOICE_CONFIRMATION_TTL_SECONDS=300
VOICE_ALLOWED_COUNTRIES=US
VOICE_BUSINESS_HOURS_START=09:00
VOICE_BUSINESS_HOURS_END=18:00

# Bootstrap-only agent provisioning (keep disabled after creation)
VOICE_AGENT_PROVISIONING_ENABLED=false
VOICE_BOOTSTRAP_KEY=

# Webhooks remain disabled until provider signature contract is verified
VOICE_WEBHOOK_ENABLED=false
VOICE_WEBHOOK_SHARED_SECRET=
